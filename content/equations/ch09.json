  {
    "id": "eq.ch09.gradient-true",
    "unit": "ch09",
    "concept": "ch09.gradient-descent",
    "name": "Gradient descent on one example's squared error",
    "bookLabel": "(9.2)",
    "tex": "\\mathbf{w}_{t+1} = \\mathbf{w}_t - \\tfrac{1}{2}\\alpha\\nabla\\Big[v_\\pi(S_t) - \\hat{v}(S_t, \\mathbf{w}_t)\\Big]^2 = \\mathbf{w}_t + \\alpha\\Big[v_\\pi(S_t) - \\hat{v}(S_t, \\mathbf{w}_t)\\Big]\\nabla\\hat{v}(S_t, \\mathbf{w}_t)",
    "symbols": [
      {
        "tex": "\\nabla",
        "meaning": "partial derivatives, one per weight"
      }
    ],
    "intuition": "A small step down the gradient of this example's squared error.",
    "assumptions": [],
    "derivation": [
      {
        "tex": "\\nabla[v_\\pi(S_t) - \\hat{v}(S_t, \\mathbf{w})]^2 = -2[v_\\pi(S_t) - \\hat{v}(S_t, \\mathbf{w})]\\nabla\\hat{v}(S_t, \\mathbf{w})",
        "why": "Chain rule; the target does not depend on w."
      }
    ],
    "pitfalls": [
      "Taking the whole step to zero error on each example would not find the balance across states."
    ],
    "sources": [
      {
        "kind": "textbook",
        "chapter": "9",
        "section": "9.2",
        "printedPages": [
          230,
          230
        ],
        "pdfPages": [
          244,
          244
        ]
      }
    ],
    "verification": {
      "method": "page-image",
      "on": "2026-11-11"
    }
  },
  {
    "id": "eq.ch09.gradient-general",
    "unit": "ch09",
    "concept": "ch09.gradient-descent",
    "name": "General gradient-descent prediction",
    "bookLabel": "(9.3)",
    "tex": "\\mathbf{w}_{t+1} = \\mathbf{w}_t + \\alpha\\Big[V_t - \\hat{v}(S_t, \\mathbf{w}_t)\\Big]\\nabla\\hat{v}(S_t, \\mathbf{w}_t)",
    "symbols": [
      {
        "tex": "V_t",
        "meaning": "the target: an estimate of $v_\\pi(S_t)$"
      }
    ],
    "intuition": "Replace the unknown true value by a target.",
    "assumptions": [],
    "significance": "Converges to a local optimum if $\\mathbb{E}[V_t] = v_\\pi(S_t)$ and α decreases as in (2.7), e.g. with Monte Carlo returns.",
    "pitfalls": [
      "Bootstrapped targets are biased, so the guarantee does not apply to them."
    ],
    "sources": [
      {
        "kind": "textbook",
        "chapter": "9",
        "section": "9.2",
        "printedPages": [
