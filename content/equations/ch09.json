  {
    "id": "eq.ch09.td-bound",
    "unit": "ch09",
    "concept": "ch09.td-bound",
    "name": "Asymptotic error bound of linear TD(λ)",
    "bookLabel": "(9.9)",
    "tex": "\\mathrm{RMSE}(\\mathbf{w}_\\infty) \\le \\frac{1 - \\gamma\\lambda}{1 - \\gamma}\\,\\mathrm{RMSE}(\\mathbf{w}^*)",
    "symbols": [
      {
        "tex": "\\mathbf{w}_\\infty",
        "meaning": "the weights linear TD(λ) converges to"
      },
      {
        "tex": "\\mathbf{w}^*",
        "meaning": "the minimum-RMSE weights"
      }
    ],
    "intuition": "Bootstrapping costs at most this factor in error; λ = 1 costs nothing.",
    "assumptions": [
      "Linear approximation, on-policy distribution, discounted continuing task, step size decreasing suitably (Tsitsiklis and Van Roy, 1997)."
    ],
    "example": "γ = 0.9, λ = 0: the bound factor is 10; with λ = 0.9 it is 1.9. On a 20-state walk with 4 aggregated groups the actual ratios are only 1.14 and 1.005 (check ch09.bound).",
    "pitfalls": [
      "A bound, often far from tight.",
      "It needs the on-policy distribution; others can diverge."
    ],
