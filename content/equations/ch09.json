  {
    "id": "eq.ch09.linear-value",
    "unit": "ch09",
    "concept": "ch09.linear-methods",
    "name": "Linear approximate value",
    "bookLabel": "(9.8)",
    "tex": "\\hat{v}(s, \\mathbf{w}) = \\mathbf{w}^\\top\\mathbf{x}(s) = \\sum_{i=1}^{n} w_i x_i(s)",
    "symbols": [
      {
        "tex": "\\mathbf{x}(s)",
        "meaning": "the feature vector of state s"
      }
    ],
    "intuition": "A weighted sum of features; its gradient is the feature vector.",
    "assumptions": [],
    "significance": "$\\nabla\\hat{v}(s, \\mathbf{w}) = \\mathbf{x}(s)$, so (9.3) becomes $\\mathbf{w} \\leftarrow \\mathbf{w} + \\alpha[V_t - \\mathbf{w}^\\top\\mathbf{x}(S_t)]\\mathbf{x}(S_t)$.",
