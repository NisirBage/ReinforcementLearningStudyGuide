[
  {
    "id": "eq.ch09.rmse",
    "unit": "ch09",
    "concept": "ch09.rmse-objective",
    "name": "Root-mean-squared error",
    "bookLabel": "(9.1)",
    "tex": "\\mathrm{RMSE}(\\mathbf{w}) = \\sqrt{\\sum_{s\\in\\mathcal{S}} d(s)\\Big[v_\\pi(s) - \\hat{v}(s, \\mathbf{w})\\Big]^2}",
    "symbols": [
      {
        "tex": "d(s)",
        "meaning": "a distribution over states: how much each state's error matters"
      },
      {
        "tex": "\\hat{v}(s, \\mathbf{w})",
        "meaning": "the approximate value"
      }
    ],
    "intuition": "Average squared error, weighted by how much each state matters.",
    "assumptions": [
      "$d(s) \\ge 0$ and $\\sum_s d(s) = 1$."
    ],
    "pitfalls": [
      "Not necessarily the right goal for control (§9.5)."
    ],
    "sources": [
