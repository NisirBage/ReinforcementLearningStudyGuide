  {
    "id": "eq.ch09.gradient-lambda-forward",
    "unit": "ch09",
    "concept": "ch09.gradient-td-lambda",
    "name": "Gradient-descent TD(λ), forward view",
    "bookLabel": "(9.4)",
    "tex": "\\mathbf{w}_{t+1} = \\mathbf{w}_t + \\alpha\\Big[G^\\lambda_t - \\hat{v}(S_t, \\mathbf{w}_t)\\Big]\\nabla\\hat{v}(S_t, \\mathbf{w}_t)",
    "symbols": [
      {
        "tex": "G^\\lambda_t",
        "meaning": "the λ-return"
      }
    ],
    "intuition": "The λ-return as the target of (9.3).",
    "assumptions": [],
    "pitfalls": [
