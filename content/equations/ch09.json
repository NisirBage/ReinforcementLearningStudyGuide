  {
    "id": "eq.ch09.gradient-trace",
    "unit": "ch09",
    "concept": "ch09.gradient-td-lambda",
    "name": "Eligibility trace vector",
    "bookLabel": "(9.7)",
    "tex": "\\mathbf{e}_t = \\gamma\\lambda\\mathbf{e}_{t-1} + \\nabla\\hat{v}(S_t, \\mathbf{w}_t), \\quad \\mathbf{e}_0 = \\mathbf{0}",
    "symbols": [
      {
        "tex": "\\nabla\\hat{v}(S_t, \\mathbf{w}_t)",
        "meaning": "how much each weight affects the current state's value"
      }
    ],
    "intuition": "Weights that recently mattered for the visited states stay eligible.",
    "assumptions": [],
    "example": "With one-hot features, $\\nabla\\hat{v}(S_t) $ is the unit vector of $S_t$ and (9.7) is the accumulating trace (7.9): Exercise 9.1.",
