  {
    "id": "eq.ch07.online-update",
    "unit": "ch07",
    "concept": "ch07.online-offline",
    "name": "On-line updating",
    "bookLabel": "(7.3)",
    "tex": "V_{t+1}(s) = V_t(s) + \\Delta_t(s), \\quad \\forall s \\in \\mathcal{S}",
    "symbols": [
      {
        "tex": "V_{t+1}",
        "meaning": "the values after step t's increment"
      }
    ],
    "intuition": "Apply each increment as soon as it is known.",
    "assumptions": [],
    "pitfalls": [
      "An n-step increment is only known n steps later; the lab reads $V_t$ as the values after the increments of steps $0, \\dots, t-1$, which is what a causal implementation has then."
    ],
    "sources": [
      {
        "kind": "textbook",
        "chapter": "7",
        "section": "7.1",
        "printedPages": [
          170,
