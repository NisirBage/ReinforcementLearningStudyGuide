  {
    "id": "eq.ch07.error-reduction",
    "unit": "ch07",
    "concept": "ch07.error-reduction",
    "name": "Error reduction property",
    "bookLabel": "(7.5)",
    "tex": "\\max_s \\Big|\\mathbb{E}_\\pi\\big[G_t^{t+n}(v(S_{t+n})) \\,\\big|\\, S_t = s\\big] - v_\\pi(s)\\Big| \\le \\gamma^n \\max_s |v(s) - v_\\pi(s)|",
    "symbols": [
      {
        "tex": "v",
        "meaning": "any value function used for the correction"
      }
    ],
    "intuition": "Looking n steps ahead shrinks the worst error by at least $\\gamma^n$.",
    "assumptions": [],
    "significance": "The basis of convergence proofs for n-step and λ-based TD methods. Check ch07.error-reduction confirms it on the 19-state walk with γ = 0.9.",
    "pitfalls": [
      "With γ = 1 the bound only says the error does not grow."
    ],
    "sources": [
      {
        "kind": "textbook",
        "chapter": "7",
        "section": "7.1",
        "printedPages": [
          171,
          171
        ],
        "pdfPages": [
          185,
