[
  {
    "id": "eq.ch07.n-step-target",
    "unit": "ch07",
    "concept": "ch07.n-step-return",
    "name": "The n-step target",
    "bookLabel": "(7.1)",
    "tex": "R_{t+1} + \\gamma R_{t+2} + \\gamma^2 + \\cdots + \\gamma^{n-1}R_{t+n} + \\gamma^n V_t(S_{t+n}), \\quad \\forall n \\ge 1",
    "symbols": [
      {
        "tex": "V_t(S_{t+n})",
        "meaning": "the estimate, at time t, of the state n steps later"
      },
      {
        "tex": "\\gamma^n",
        "meaning": "its discount"
      }
    ],
    "intuition": "n real rewards, then the current estimate stands in for all the rest.",
    "assumptions": [],
    "pitfalls": [
      "As printed, the third term is $\\gamma^2$ alone; it should be $\\gamma^2 R_{t+3}$ (flagged)."
    ],
    "sources": [
      {
        "kind": "textbook",
        "chapter": "7",
        "section": "7.1",
        "printedPages": [
          169,
          169
        ],
        "pdfPages": [
          183,
          183
        ]
      }
    ],
    "verification": {
      "method": "page-image",
      "on": "2026-11-11"
    },
    "flags": [
      {
        "type": "suspected-typo",
        "note": "The printed target reads '$R_{t+1} + \\gamma R_{t+2} + \\gamma^2 + \\cdots$': the reward $R_{t+3}$ is missing from the third term (checked on the page image). The transcription keeps it as printed.",
        "suggestion": "$R_{t+1} + \\gamma R_{t+2} + \\gamma^2 R_{t+3} + \\cdots + \\gamma^{n-1}R_{t+n} + \\gamma^n V_t(S_{t+n})$"
      }
    ]
  },
  {
    "id": "eq.ch07.n-step-increment",
    "unit": "ch07",
    "concept": "ch07.n-step-td",
    "name": "The n-step backup",
    "bookLabel": "(7.2)",
    "tex": "\\Delta_t(S_t) = \\alpha\\Big[G_t^{t+n}(V_t(S_{t+n})) - V_t(S_t)\\Big]",
    "symbols": [
      {
        "tex": "\\Delta_t(S_t)",
        "meaning": "the increment to the visited state's value (0 for other states)"
      },
      {
        "tex": "G_t^{t+n}(c)",
        "meaning": "the n-step return with correction c"
      }
    ],
    "intuition": "Move the estimate toward the n-step return.",
    "assumptions": [
      "Defined as an increment so that it can be applied on-line (7.3) or off-line (7.4)."
    ],
    "pitfalls": [],
    "sources": [
      {
        "kind": "textbook",
        "chapter": "7",
