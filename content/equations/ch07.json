  {
    "id": "eq.ch07.lambda-return",
    "unit": "ch07",
    "concept": "ch07.lambda-return",
    "name": "The λ-return, split at termination",
    "bookLabel": "(7.6)",
    "tex": "L_t = (1-\\lambda)\\sum_{n=1}^{T-t-1}\\lambda^{n-1}G_t^{t+n}(V_t(S_{t+n})) + \\lambda^{T-t-1}G_t",
    "symbols": [
      {
        "tex": "L_t",
        "meaning": "the λ-return (written $G^\\lambda_t$ in §7.9)"
      },
      {
        "tex": "\\lambda",
        "meaning": "the weight decay, in [0, 1]"
      }
    ],
    "intuition": "Weight the 1-step return most, then each longer return λ times less; whatever weight is left goes to the complete return.",
    "assumptions": [],
    "derivation": [
      {
        "tex": "L_t = (1-\\lambda)\\sum_{n=1}^{\\infty}\\lambda^{n-1}G_t^{t+n}(V_t(S_{t+n}))",
        "why": "The definition: every n-step return, weight $(1-\\lambda)\\lambda^{n-1}$."
      },
      {
        "tex": "(1-\\lambda)\\sum_{n=T-t}^{\\infty}\\lambda^{n-1}G_t = \\lambda^{T-t-1}G_t",
        "why": "From n = T − t on, every n-step return is the complete return $G_t$; the geometric tail sums to $\\lambda^{T-t-1}$."
      }
    ],
    "example": "With λ = 0.5 the 1-, 2- and 3-step returns get weights 0.5, 0.25 and 0.125.",
    "pitfalls": [
      "The draft writes it $L_t$ here and $G^\\lambda_t$ in §7.9 (flagged on the concept)."
    ],
    "sources": [
      {
        "kind": "textbook",
        "chapter": "7",
        "section": "7.2",
        "printedPages": [
          173,
          173
        ],
        "pdfPages": [
          187,
