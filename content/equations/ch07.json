  {
    "id": "eq.ch07.offline-update",
    "unit": "ch07",
    "concept": "ch07.online-offline",
    "name": "Off-line updating",
    "bookLabel": "(7.4)",
    "tex": "V_{t+1}(s) = V_t(s), \\;\\forall t < T, \\qquad V_T(s) = V_{T-1}(s) + \\sum_{t=0}^{T-1}\\Delta_t(s)",
    "symbols": [
      {
        "tex": "T",
        "meaning": "the episode's final time step"
      }
    ],
    "intuition": "Hold the values fixed through the episode, then apply the sum of its increments.",
    "assumptions": [],
    "pitfalls": [],
    "sources": [
