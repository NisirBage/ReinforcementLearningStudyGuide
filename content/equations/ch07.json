    "id": "eq.ch07.accumulating-trace",
    "unit": "ch07",
    "concept": "ch07.td-lambda",
    "name": "Accumulating trace",
    "bookLabel": "(7.9)",
    "tex": "E_t(S_t) = \\gamma\\lambda E_{t-1}(S_t) + 1",
