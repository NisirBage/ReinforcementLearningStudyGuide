  {
    "id": "eq.ch06.td0",
    "unit": "ch06",
    "concept": "ch06.td-prediction",
    "name": "TD(0) update",
    "bookLabel": "(6.2)",
    "tex": "V(S_t) \\leftarrow V(S_t) + \\alpha\\Big[R_{t+1} + \\gamma V(S_{t+1}) - V(S_t)\\Big]",
    "symbols": [
      {
        "tex": "R_{t+1} + \\gamma V(S_{t+1})",
        "meaning": "the TD target"
      },
      {
        "tex": "R_{t+1} + \\gamma V(S_{t+1}) - V(S_t)",
        "meaning": "the TD error"
      }
    ],
    "intuition": "Learn a guess from a guess: one sampled step plus the current estimate of where it led.",
    "assumptions": [
      "$V$ of a terminal state is 0."
    ],
    "pitfalls": [
      "The target uses the current estimate $V(S_{t+1})$, not the true $v_\\pi(S_{t+1})$."
    ],
    "sources": [
      {
        "kind": "textbook",
        "chapter": "6",
