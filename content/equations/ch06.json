  {
    "id": "eq.ch06.sarsa",
    "unit": "ch06",
    "concept": "ch06.sarsa",
    "name": "Sarsa update",
    "bookLabel": "(6.5)",
    "tex": "Q(S_t,A_t) \\leftarrow Q(S_t,A_t) + \\alpha\\Big[R_{t+1} + \\gamma Q(S_{t+1},A_{t+1}) - Q(S_t,A_t)\\Big]",
    "symbols": [
      {
        "tex": "A_{t+1}",
        "meaning": "the next action actually chosen by the (ε-greedy) policy"
      }
    ],
    "intuition": "The target uses the action the agent will really take next, so exploration is part of what is learned.",
    "assumptions": [
      "If $S_{t+1}$ is terminal, $Q(S_{t+1}, A_{t+1}) = 0$ (p. 155)."
    ],
    "pitfalls": [
      "$A_{t+1}$ must be chosen before the update and then actually taken."
    ],
    "sources": [
      {
        "kind": "textbook",
        "chapter": "6",
