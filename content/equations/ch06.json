[
  {
    "id": "eq.ch06.constant-alpha-mc",
    "unit": "ch06",
    "concept": "ch06.td-prediction",
    "name": "Constant-α Monte Carlo",
    "bookLabel": "(6.1)",
    "tex": "V(S_t) \\leftarrow V(S_t) + \\alpha\\Big[G_t - V(S_t)\\Big]",
    "symbols": [
      {
        "tex": "G_t",
        "meaning": "the actual return after time t"
      },
      {
        "tex": "\\alpha",
        "meaning": "a constant step size"
      }
    ],
    "intuition": "Monte Carlo with a fixed step: the target is the whole return, known only when the episode ends.",
    "assumptions": [
      "Every-visit, suited to nonstationary problems (p. 144)."
    ],
    "pitfalls": [
      "The update cannot be made until the episode is over."
    ],
