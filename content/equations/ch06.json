  {
    "id": "eq.ch06.q-learning",
    "unit": "ch06",
    "concept": "ch06.q-learning",
    "name": "Q-learning update",
    "bookLabel": "(6.6)",
    "tex": "Q(S_t,A_t) \\leftarrow Q(S_t,A_t) + \\alpha\\Big[R_{t+1} + \\gamma \\max_a Q(S_{t+1},a) - Q(S_t,A_t)\\Big]",
    "symbols": [
      {
        "tex": "\\max_a Q(S_{t+1}, a)",
        "meaning": "the value of the best next action, whatever the agent does next"
      }
    ],
    "intuition": "The target assumes the best action from the next state, so Q learns the optimal values while the agent explores.",
    "assumptions": [
      "All state–action pairs must keep being updated for convergence to $q_*$ (p. 157)."
    ],
    "pitfalls": [
      "The next action taken may differ from the one in the target; that is what makes Q-learning off-policy."
    ],
    "sources": [
