[
  {
    "id": "alg.ch06.td0",
    "unit": "ch06",
    "concept": "ch06.td-prediction",
    "name": "Tabular TD(0)",
    "bookLabel": "Figure 6.1",
    "inputs": [
      "the policy $\\pi$ to evaluate",
      "step size $\\alpha$"
    ],
    "lines": [
      {
        "indent": 0,
        "text": "Start with any $V$ (terminal states 0)"
      },
      {
        "indent": 0,
        "text": "for each episode:"
      },
      {
        "indent": 1,
        "text": "set $S$ to the start state"
      },
      {
        "indent": 1,
        "text": "repeat until $S$ is terminal:"
      },
      {
        "indent": 2,
        "text": "take the action $\\pi$ gives for $S$; see $R$ and $S'$"
      },
      {
        "indent": 2,
        "text": "$V(S) \\leftarrow V(S) + \\alpha[R + \\gamma V(S') - V(S)]$"
      },
      {
        "indent": 2,
        "text": "$S \\leftarrow S'$"
      }
    ],
    "output": "$V \\approx v_\\pi$",
    "implementation": "td.td0Update",
