  {
    "id": "alg.ch06.sarsa",
    "unit": "ch06",
    "concept": "ch06.sarsa",
    "name": "Sarsa",
    "bookLabel": "Figure 6.9",
    "inputs": [
      "step size $\\alpha$",
      "exploration ε"
    ],
    "lines": [
      {
        "indent": 0,
        "text": "Start with any $Q(s, a)$; $Q$ of a terminal state is 0"
      },
      {
        "indent": 0,
        "text": "for each episode:"
      },
      {
        "indent": 1,
        "text": "set $S$; choose $A$ from $S$ ε-greedily with respect to $Q$"
      },
      {
        "indent": 1,
        "text": "repeat until $S$ is terminal:"
      },
      {
        "indent": 2,
        "text": "take $A$; see $R$ and $S'$"
      },
      {
        "indent": 2,
        "text": "choose $A'$ from $S'$ ε-greedily with respect to $Q$"
      },
      {
        "indent": 2,
        "text": "$Q(S, A) \\leftarrow Q(S, A) + \\alpha[R + \\gamma Q(S', A') - Q(S, A)]$"
      },
      {
        "indent": 2,
        "text": "$S \\leftarrow S'$, $A \\leftarrow A'$"
      }
    ],
    "output": "$Q$ for the ε-greedy policy being followed",
    "implementation": "td.sarsaStep",
