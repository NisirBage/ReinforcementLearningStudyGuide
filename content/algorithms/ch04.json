  {
    "id": "alg.ch04.policy-iteration",
    "unit": "ch04",
    "concept": "ch04.policy-iteration",
    "name": "Policy iteration",
    "bookLabel": "Figure 4.3",
    "inputs": [
      "small threshold $\\theta > 0$"
    ],
    "lines": [
      {
        "indent": 0,
        "text": "Start with any $V$ and any deterministic $\\pi$"
      },
      {
        "indent": 0,
        "text": "repeat"
      },
      {
        "indent": 1,
        "text": "Evaluate: sweep with $V(s) \\leftarrow \\sum_{s',r} p(s',r|s,\\pi(s))[r + \\gamma V(s')]$ until the largest change is below $\\theta$"
      },
      {
        "indent": 1,
        "text": "Improve: for every $s$, remember the old action, then set $\\pi(s)$ to an action maximizing $\\sum_{s',r} p(s',r|s,a)[r + \\gamma V(s')]$"
      },
      {
        "indent": 1,
        "text": "if no state changed its action: stop with $V$ and $\\pi$"
      }
    ],
    "output": "$V \\approx v_*$ and an optimal $\\pi$",
    "implementation": "dp.policyIteration",
    "sources": [
      {
        "kind": "textbook",
        "chapter": "4",
        "section": "4.3",
        "printedPages": [
          97,
