{
  "name": "rl-study-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "validate": "tsx ../tools/validate_content.ts",
    "overlap": "python -I ../tools/check_overlap.py --n 9",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run validate && npm run typecheck && vite build && tsx ../tools/check_dist_privacy.ts",
    "preview": "vite preview",
    "check": "npm run validate && tsx ../tools/coverage_report.ts --check && npm run typecheck && vitest run && npm run overlap && vite build && tsx ../tools/check_dist_privacy.ts",
    "coverage": "tsx ../tools/coverage_report.ts",
    "inventory": "python -I ../tools/build_inventory.py"
  },
  "dependencies": {
    "katex": "0.18.11",
    "markdown-it": "15.0.3",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=24"
  }
}
